{
  "name": "gestao-manutencao",
  "version": "1.3.0",
  "description": "Sistema de Gestão de Manutenção",
  "author": "Marcos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.marcos.gestaomanutencao",
    "productName": "Gestao de Manutencao",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "icon": "app/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GestaoManutencao.exe"
    }
  }
}
