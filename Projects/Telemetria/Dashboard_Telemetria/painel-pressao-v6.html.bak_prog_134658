/* ---------- Rota no mapa (TomTom, embutida no painel) ---------- */
let rotaMap=null, rotaLinha=null, rotaDest=null, rotaBaseM=null;
function _fmtRota(h){ const m=Math.round(h*60); return h>=1?(Math.floor(h)+"h"+String(m%60).padStart(2,"0")):(m+" min"); }
/* origem/destino de uma empresa: prioriza o viagem.js (varias bases); cai p/ Betim fixo */
function rotaInfo(n){
  const d=window.LOGAS_VIAGEM;
  if(d&&d.rotas&&d.rotas[n]) return d.rotas[n];   // ao vivo (viagem.js) tem prioridade
  if(ROTA_IDX[n]) return ROTA_IDX[n];             // fallback fixo (todas as bases)
  return null;
}
function openRota(n){
  const ri=rotaInfo(n); if(!ri) return;
  document.getElementById("rotaNome").textContent=nomeExib(n)+" — base "+ri.base;
  document.getElementById("rotaInfo").textContent="Calculando rota…";
  document.getElementById("rotaOverlay").classList.add("open");
  setTimeout(function(){
    if(!rotaMap){
      rotaMap=L.map("rotaMap",{zoomControl:true}).setView(ri.baseLL,9);
      L.tileLayer("https://api.tomtom.com/map/1/tile/basic/main/{z}/{x}/{y}.png?key="+ROTA_KEY,{maxZoom:18,attribution:"© TomTom"}).addTo(rotaMap);
    }
    rotaMap.invalidateSize();
    desenharRota(n, ri);
  },60);
}
function desenharRota(n, ri){
  const info=document.getElementById("rotaInfo");
  const url="https://api.tomtom.com/routing/1/calculateRoute/"+ri.baseLL[0]+","+ri.baseLL[1]+":"+ri.destLL[0]+","+ri.destLL[1]
    +"/json?key="+ROTA_KEY+"&traffic=true&travelMode=truck&vehicleCommercial=true&vehicleMaxSpeed="+ROTA_VEL+"&routeType=fastest";
  fetch(url).then(function(resp){
    if(!resp.ok){ return resp.json().catch(function(){return {};}).then(function(e){ throw new Error((e.detailedError&&e.detailedError.message)||("HTTP "+resp.status)); }); }
    return resp.json();
  }).then(function(d){
    const route=d.routes[0], pts=[];
    route.legs.forEach(function(l){ l.points.forEach(function(p){ pts.push([p.latitude,p.longitude]); }); });
    if(rotaLinha) rotaMap.removeLayer(rotaLinha);
    if(rotaDest) rotaMap.removeLayer(rotaDest);
    if(rotaBaseM) rotaMap.removeLayer(rotaBaseM);
    rotaBaseM=L.circleMarker(ri.baseLL,{radius:8,color:"#0a0f18",weight:2,fillColor:"#2bd18a",fillOpacity:1}).addTo(rotaMap).bindPopup("Base "+ri.base);
    rotaLinha=L.polyline(pts,{color:"#3bc4ec",weight:5,opacity:.9}).addTo(rotaMap);
    rotaDest=L.circleMarker(ri.destLL,{radius:8,color:"#0a0f18",weight:2,fillColor:"#f59140",fillOpacity:1}).addTo(rotaMap).bindPopup(nomeExib(n));
    rotaMap.fitBounds(rotaLinha.getBounds(),{padding:[40,40]});
    const km=route.summary.lengthInMeters/1000, tt=route.summary.travelTimeInSeconds/3600;
    const plan=tt*(1+ROTA_MARGEM), atraso=Math.round((route.summary.trafficDelayInSeconds||0)/60);
    info.innerHTML="Base <b>"+ri.base+"</b> · Distância <b>"+km.toFixed(1)+" km</b> · Tempo planejado (+25%) <b>"+_fmtRota(plan)+"</b> · TomTom c/ trânsito <b>"+_fmtRota(tt)+"</b>"+(atraso>0?" · atraso "+atraso+" min":"");
  }).catch(function(err){
    info.textContent="Não consegui calcular a rota: "+err.message+" (verifique internet/chave).";
  });
}
function closeRota(){ document.getElementById("rotaOverlay").classList.remove("open"); }
document.getElementById("dRota").onclick=()=>{ if(current) openRota(current.n); };
document.getElementById("rotaClose").onclick=closeRota;
["detailOverlay","cfgOverlay","dispOverlay","exportOverlay","rotaOverlay"].forEach(id=>{
  document.getElementById(id).onclick=e=>{if(e.target.id===id){e.target.classList.remove("open");if(id==="detailOverlay"&&chart){chart.destroy();chart=null;}}};
});
