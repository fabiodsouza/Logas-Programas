const _EXTREMA_LL=[-22.879789341622573,-46.37153143232148];
const ROTA_BASES={
  "Betim":{ll:[-19.956313674094236,-44.13045441870082],emp:{
    "ALSCO":[-19.99688525938805,-44.04234853219335],"BELGO":[-19.88015658498822,-43.79436691246574],
    "EXTRUMINAS":[-19.784602405046915,-44.30053450924594],"M.PEQUI":[-19.63405367583952,-44.64858965619242],
    "VDL":[-20.223776765982244,-43.80441798800982],"MG STEEL":[-20.0101038138369,-44.43642493526554],
    "VILMA":[-19.999554235688944,-44.235817118699714],"G.PERDÕES":[-21.163806206103395,-45.12207431634263],
    "JD CANADÁ":[-20.06183436258079,-43.98785491877735],"FORTLEV":[-19.83672647219803,-44.08215546741692]}},
  "Barbacena":{ll:[-21.218483045099013,-43.74357509319152],emp:{
    "AMG SP":[-21.084951701950843,-44.58957361808009],"DOW":[-21.4471714105341,-43.60857273399927]}},
  "Poços de Caldas":{ll:[-21.832402609646568,-46.638100827678535],emp:{
    "ACQUION":[-21.836972399653416,-46.65197019071189],
    "BAIA 1":_EXTREMA_LL,"BAIA 2":_EXTREMA_LL,"BAIA 3":_EXTREMA_LL}},
  "Ipatinga":{ll:[-19.49428141512894,-42.5641418151882],emp:{
