/* Nome curto na tela (chave interna fica única p/ não colidir com as baias de Extrema). */
const NOME_EXIB = { "BAIA 1 (LAGARTO)":"BAIA 1", "BAIA 2 (LAGARTO)":"BAIA 2" };
function nomeExib(n){ return NOME_EXIB[n]||n; }
function grupoDe(n){ for(const reg in GRUPOS){ if(GRUPOS[reg].indexOf(n)>=0) return reg; } return null; }
const MIN_PADRAO = 30;
const TROCA_MIN_BAR = 25;  // subida mínima entre fotos para cogitar troca de carreta
const TROCA_NOVA = 160;    // toda troca de carreta leva o nível para ≥ este valor (Bar)
const MAX_QUEDA_BARH = 100; // queda maior que isso (Bar/h) entre leituras = provável erro de OCR (leitura ignorada)
const MAX_BAR = 260;        // pressão acima disso é impossível (manômetro vai até ~250) → ignorada

