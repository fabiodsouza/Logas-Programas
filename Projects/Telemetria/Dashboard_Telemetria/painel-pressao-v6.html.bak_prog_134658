};

/* ---------- Rota no mapa: base, empresas e chave TomTom (lado navegador) ---------- */
const ROTA_KEY="QKOjjJCpYZm3VPqrNJ321dW9Pa9d1acK";
const ROTA_VEL=80, ROTA_MARGEM=0.25;   // margem sobre o tempo da TomTom (+25%)
const ROTA_BASE=[-19.956313674094236,-44.13045441870082];
const ROTA_EMP={
