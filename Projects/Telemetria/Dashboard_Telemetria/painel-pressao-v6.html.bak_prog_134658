function tick(){document.getElementById("clock").textContent=new Date().toLocaleTimeString("pt-BR");}

/* init */
if(cfg.buffer!=null)document.getElementById("buffer").value=cfg.buffer;
if(cfg.fallback!=null)document.getElementById("fallback").value=cfg.fallback;
