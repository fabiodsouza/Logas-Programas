  "Ipatinga":        {caminhoes:1, empresas:["FERMAG","PLANALTO","TROPICAL","BARRIGÃO"]},
};
function caminhoesBase(conf){
  if(typeof conf.caminhoes==="number") return conf.caminhoes;
  const h=new Date().getHours(), dia=(h>=TURNO_DIA[0] && h<TURNO_DIA[1]);
  return dia ? conf.caminhoes.dia : conf.caminhoes.noite;
}
/* Motorista + carreta por entrega, salvos no navegador */
function despStore(){try{return JSON.parse(localStorage.getItem("logas_despacho"))||{};}catch(e){return {};}}
function saveDesp(s){try{localStorage.setItem("logas_despacho",JSON.stringify(s));}catch(e){}}
function labelDespacho(base,n){ return (base==="Poços de Caldas" && n==="BAIA 1") ? "Extrema" : nomeExib(n); }
const ADIANTAR_BAR = 60;     // pressão a partir da qual já é aceitável adiantar a entrega
const SERVICO_H = 0.5;       // tempo aprox. de carga/descarga na empresa (round-trip = 2*viagem + serviço)

/* mapa empresa -> região */
const REGIAO_DE = {};
for(const reg in REGISTRO) REGISTRO[reg].forEach(n=>REGIAO_DE[n]=reg);

/* ---------- Config persistida ---------- */
function loadCfg(){try{return JSON.parse(localStorage.getItem("logas_cfg"))||{};}catch(e){return{};}}
let cfg = loadCfg();
function getMin(n){return (cfg.min&&cfg.min[n]!=null)?cfg.min[n]:MIN_PADRAO;}
function getBase(n){
  if(cfg.base&&cfg.base[n]!=null&&cfg.base[n]!=="")return cfg.base[n];
  const d=window.LOGAS_VIAGEM;
  if(d&&d.rotas&&d.rotas[n]&&d.rotas[n].base) return d.rotas[n].base;   // base ao vivo (viagem.js)
  if(ROTA_IDX[n]) return ROTA_IDX[n].base;                             // base fixa (todas as bases)
  return BASE_POR_REGIAO[REGIAO_DE[n]]||"";
}
/* tempo de viagem AO VIVO (TomTom), vindo do viagem.js (window.LOGAS_VIAGEM) */
function viagemLive(n){
  const d=window.LOGAS_VIAGEM;
  return (d&&d.viagem&&d.viagem[n]!=null&&d.viagem[n]!=="")?parseFloat(d.viagem[n]):null;
}
function getViagem(n){
  if(cfg.viagem&&cfg.viagem[n]!=null&&cfg.viagem[n]!=="")return parseFloat(cfg.viagem[n]); // override manual (engrenagem)
  const lv=viagemLive(n); if(lv!=null) return lv;                                          // tempo real (TomTom)
  if(VIAGEM_BETIM[n]!=null)return VIAGEM_BETIM[n];                                          // tempo fixo
  return REGIAO_DE[n]==="BETIM"?1:null;
}
function buffer(){return parseFloat(document.getElementById("buffer").value)||0;}
function fallbackRate(){return parseFloat(document.getElementById("fallback").value)||20;}
function saveCfg(){
  cfg.buffer=buffer();cfg.fallback=fallbackRate();
  try{localStorage.setItem("logas_cfg",JSON.stringify(cfg));}catch(e){}
}

/* ---------- Leituras manuais (digitadas no painel, salvas no navegador) ---------- */
function manualStore(){try{return JSON.parse(localStorage.getItem("logas_manual"))||{};}catch(e){return {};}}
function saveManual(s){try{localStorage.setItem("logas_manual",JSON.stringify(s));}catch(e){}}
function nowLocalISO(){
  const d=new Date(),p=x=>String(x).padStart(2,"0");
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
}

/* ---------- Correções de leitura (quando o sistema leu errado o valor da foto) ----------
   Guardadas por empresa e por horário (t). Sobrescrevem o valor do dados.js e
   sobrevivem ao recarregamento automático, porque são aplicadas em leituras(). */
function correcoesStore(){try{return JSON.parse(localStorage.getItem("logas_correcoes"))||{};}catch(e){return {};}}
function saveCorrecoes(s){try{localStorage.setItem("logas_correcoes",JSON.stringify(s));}catch(e){}}
function leiturasBase(n){
  const d=window.LOGAS_DADOS;
  const base=(d&&d.leituras&&d.leituras[n])?d.leituras[n].slice():[];
  const corr=correcoesStore()[n]||{};
  return base.map(r=>{
    const c=corr[r.t];
    return (c!=null&&c!=="") ? {...r,p:c,corrigido:true,pOrig:r.p} : {...r};
  });
}

/* ---------- Acesso aos dados (arquivo dados.js + correções + manuais) ---------- */
function leituras(n){
  const base=leiturasBase(n);
  const man=manualStore()[n]||[];
  const all=base.concat(man);
  all.sort((a,b)=>new Date(a.t)-new Date(b.t));
  return all;
}
function ultimaLeitura(n){
  const ls=leituras(n);
  for(let i=ls.length-1;i>=0;i--){if(ls[i].p!==null&&ls[i].p!==undefined)return ls[i];}
  return ls.length?ls[ls.length-1]:null;
}
/* Se a leitura MAIS RECENTE for nula, a empresa está fora do ar.
   Retorna o texto do status e desde quando (início da sequência de nulos no fim). */
function semSinalInfo(n){
  const ls=leituras(n);
  if(!ls.length)return null;
  const last=ls[ls.length-1];
  if(last.p!==null&&last.p!==undefined)return null;
  let i=ls.length-1;
  while(i>0 && (ls[i-1].p===null||ls[i-1].p===undefined)) i--;
  return {obs:last.obs||"Sem Sinal", desde:ls[i].t};
}

/* Consumo medido: média das quedas reais entre leituras (ignora trocas de carreta = subidas). */
function consumoMedido(n){
  const ls=leituras(n).filter(r=>r.p!==null&&r.p!==undefined&&r.p<=MAX_BAR);
  if(ls.length<2)return null;
  const taxas=[];
  for(let i=1;i<ls.length;i++){
    const dh=(new Date(ls[i].t)-new Date(ls[i-1].t))/3600000;
    if(dh<=0)continue;
    const queda=ls[i-1].p-ls[i].p;
    if(queda>0 && queda/dh<=MAX_QUEDA_BARH)taxas.push(queda/dh);  // só quedas plausíveis (ignora pico de erro de OCR)
  }
  if(!taxas.length)return null;
  const recentes=taxas.slice(-4);            // média das últimas quedas
  return recentes.reduce((a,b)=>a+b,0)/recentes.length;
}

function round(x){return Math.round(x*10)/10;}
function fmtH(h){if(h==null)return"—";if(!isFinite(h))return"∞";if(h<=0)return"0 h";if(h<1)return Math.round(h*60)+" min";return round(h)+" h";}
function vbar(x){return Number(x).toFixed(2).replace('.',',');}

/* Extrema-MG: 3 baias para o mesmo cliente. O status do conjunto olha a baia que está
   suprindo (a de maior pressão no momento) e o consumo real (maior consumo medido entre as baias).
   Uma baia em 0 não gera alerta se outra ainda tem gás. */
function estadoGrupo(reg){
  const baias=GRUPOS[reg];
  const atuais=baias.map(nb=>{const r=ultimaLeitura(nb);return (r&&r.p!=null)?r.p:0;});
  let sup=0;for(let i=1;i<atuais.length;i++) if(atuais[i]>atuais[sup]) sup=i;
  const supName=baias[sup], supP=atuais[sup], min=getMin(supName);
  let medido=null;
  baias.forEach(nb=>{const m=consumoMedido(nb);if(m!=null)medido=(medido==null)?m:Math.max(medido,m);});
  const rate=medido!=null?medido:fallbackRate();
  const h=rate>0?(supP-min)/rate:Infinity;
  const viagem=getViagem(supName), base=getBase(supName), buf=buffer();
  const temDespacho=(viagem!=null && !!base);
  const despacho=temDespacho?h-(viagem+buf):null;
  let key="ok",col="var(--green)",tag=fmtH(h);
  if(h<=0){ key="crit";col="var(--red)";tag="ABAIXO DO LIMITE"; }
  else if(temDespacho){
    if(despacho<=0){ key="crit";col="var(--red)";tag="DESPACHAR AGORA"; }
    else if(despacho<2){ key="urg";col="var(--orange)";tag="Sair em "+fmtH(despacho); }
    else if(despacho<6){ key="warn";col="var(--yellow)";tag="Sair em "+fmtH(despacho); }
    else { key="ok";col="var(--green)";tag="Sair em "+fmtH(despacho); }
  } else { if(!isFinite(h)){tag="∞";} else if(h<2){key="urg";col="var(--orange)";} else if(h<12){key="warn";col="var(--yellow)";} }
  return {min,rate,medido,h,viagem,base,buf,temDespacho,despacho,key,col,tag,supName};
}

function estado(n){
  // Baias de um conjunto (Extrema-MG, Lagarto-SE): pressão própria no card, status do conjunto
  const gReg=grupoDe(n);
  if(gReg){
    const g=estadoGrupo(gReg);
    const r=ultimaLeitura(n);
    const p=(r&&r.p!=null)?r.p:0;
    return {off:false,semSinal:false,grupo:gReg,suprindo:(n===g.supName),
            p,t:r?r.t:null,min:g.min,rate:g.rate,medido:g.medido,h:g.h,
            viagem:g.viagem,base:g.base,buf:g.buf,temDespacho:g.temDespacho,despacho:g.despacho,key:g.key,col:g.col,tag:g.tag};
  }
  const ss=semSinalInfo(n);                       // != null se a leitura mais recente é nula (fora do ar)
  const semSinal=!!ss;
  const foraHoras = ss ? (Date.now()-new Date(ss.desde))/3600000 : null;
  const desde = ss ? ss.desde : null;
  const obs = ss ? ss.obs : null;
  // Anti-erro de OCR: se a última leitura numérica é uma queda fisicamente impossível
  // vs a anterior (> MAX_QUEDA_BARH), ela é ignorada e usamos a anterior (confiável).
  let reg=ultimaLeitura(n), suspeita=null;          // última leitura COM valor
  {
    const _all=leituras(n).filter(r=>r.p!=null&&r.p!==undefined);
    if(_all.length>=1){
      const _b=_all[_all.length-1];
      let _a=null; for(let i=_all.length-2;i>=0;i--){ if(_all[i].p<=MAX_BAR){ _a=_all[i]; break; } }  // última boa anterior
      if(_b.p>MAX_BAR){                               // valor impossível (acima do manômetro) → usa a última boa
        suspeita={lida:_b.p,t:_b.t}; reg=_a||_b;
      } else if(_a){
        const _dh=(new Date(_b.t)-new Date(_a.t))/3600000;
        if(_dh>0 && (_a.p-_b.p)/_dh>MAX_QUEDA_BARH){ suspeita={lida:_b.p,t:_b.t}; reg=_a; }
      }
    }
  }
  const min=getMin(n);
  if(!reg||reg.p===null||reg.p===undefined)        // nunca teve leitura numérica → realmente sem dados
    return {off:true,semSinal,obs:obs||(reg?reg.obs:"sem leitura"),desde,foraHoras,p:null};
  const medido=consumoMedido(n);
  const rate=medido!=null?medido:fallbackRate();
  // Projeção quando fora do ar: a empresa continua consumindo a partir do último
  // valor conhecido. Estimamos a pressão "agora" como se a leitura não tivesse caído,
  // e usamos essa previsão para horas até o limite, despacho e alertas.
  const pConhecido=reg.p;
  let p=reg.p, projetado=false;
  const horasSemLeitura=(Date.now()-new Date(reg.t))/3600000;
  if(semSinal && rate>0 && horasSemLeitura>0){
    p=Math.max(0, reg.p - rate*horasSemLeitura);
    projetado=true;
  }
  const h=rate>0?(p-min)/rate:Infinity;            // horas até o limite (sobre a pressão prevista)
  const viagem=getViagem(n), base=getBase(n), buf=buffer();
  const temDespacho = (viagem!=null && !!base);
  const despacho = temDespacho ? h-(viagem+buf) : null; // horas até precisar sair da base

  let key="ok",col="var(--green)",tag=fmtH(h);
  if(h<=0){ key="crit";col="var(--red)";tag="ABAIXO DO LIMITE"; }
  else if(temDespacho){
    if(despacho<=0){ key="crit";col="var(--red)";tag="DESPACHAR AGORA"; }
    else if(despacho<2){ key="urg";col="var(--orange)";tag="Sair em "+fmtH(despacho); }
    else if(despacho<6){ key="warn";col="var(--yellow)";tag="Sair em "+fmtH(despacho); }
    else { key="ok";col="var(--green)";tag="Sair em "+fmtH(despacho); }
  } else { // base ainda não definida → só horas até o limite
    if(!isFinite(h)){ tag="∞"; }
    else if(h<2){ key="urg";col="var(--orange)"; }
    else if(h<12){ key="warn";col="var(--yellow)"; }
  }
  return {off:false,semSinal,foraHoras,desde,obs,p,projetado,pConhecido,tLeitura:reg.t,horasSemLeitura,t:reg.t,min,rate,medido,h,viagem,base,buf,temDespacho,despacho,key,col,tag,suspeita};
}

/* ---------- Despacho Betim: janelas de saída, 3 caminhões e conflitos ----------
   Para cada empresa de Betim calcula:
     - latest  = horas até o caminhão PRECISAR sair da base (chegar antes do limite crítico)
     - earliest= horas a partir das quais já dá pra adiantar (pressão chegando a 60 Bar)
   Depois agenda em 3 caminhões (round-trip = ida+volta+serviço) priorizando as mais
   urgentes; quem não cabe na frota a tempo é marcado como CONFLITO. A ordem de saída
   recomendada já adianta as mais distantes (têm menos folga e ocupam mais o caminhão). */
function despachoBase(baseNome){
  const conf=DESPACHO_BASES[baseNome];
  if(!conf) return {plan:[],conflitos:0};
  const jobs=[];
  conf.empresas.forEach(n=>{
    const e=estado(n);
    if(e.off) return;                 // sem leitura numérica → fora do planejamento
    if(!(e.rate>0)||!isFinite(e.h)) return;  // pressão estável/subindo → sem previsão de esvaziar
    const viagem=e.viagem!=null?e.viagem:getViagem(n);
    if(viagem==null) return;
    const buf=e.buf||0;
    const tTo60 = e.p>ADIANTAR_BAR ? (e.p-ADIANTAR_BAR)/e.rate : 0;
    jobs.push({
      n, p:e.p, rate:e.rate, viagem, min:e.min, h:e.h, semSinal:!!e.semSinal,
      earliest: tTo60 - viagem - buf,   // pode sair a partir daqui (h a partir de agora)
      latest: e.despacho,               // tem que sair até aqui (h a partir de agora)
      rt: 2*viagem + SERVICO_H,         // ocupação do caminhão (ida+volta+serviço)
      podeAdiantar: e.p<=ADIANTAR_BAR,  // já está em faixa de troca antecipada
      // Pressão projetada no horário-limite de saída (consumo constante): chega ao limite após a viagem
      barLimite: e.min + e.rate*viagem
    });
  });
  // Só planeja o que está dentro do horizonte (próx. 24 h) ou já vencido
  const plan=jobs.filter(j=>j.latest<24);
  // Earliest-Deadline-First em N caminhões
  plan.sort((a,b)=>a.latest-b.latest);
  const trucks=new Array(caminhoesBase(conf)).fill(0);  // "livre daqui a X h"
  let conflitos=0;
  plan.forEach(j=>{
    let ti=0; for(let i=1;i<trucks.length;i++) if(trucks[i]<trucks[ti]) ti=i;
    const free=trucks[ti];
    j.conflito = free > j.latest + 1e-6;            // nenhum caminhão livre a tempo
    if(j.conflito) conflitos++;
    j.depart = Math.max(free, j.earliest);           // sai o quanto antes for permitido
    j.truck  = ti;
    trucks[ti] = j.depart + j.rt;
  });
  // Ordem recomendada de saída = por horário de partida
  plan.sort((a,b)=>a.depart-b.depart || a.latest-b.latest);
  return {plan, conflitos};
}

function fmtRelogio(h){
  if(h<=0.05) return "AGORA";
  const d=new Date(Date.now()+h*3600*1000);
  const p=x=>String(x).padStart(2,"0");
  const hora=`${p(d.getHours())}:${p(d.getMinutes())}`;
  const hoje=new Date().toDateString()===d.toDateString();
  // Hoje: só a hora. Outro dia: "dd/mm · hh:mm" com separador para a data não colar na hora.
  return hoje ? hora : `${p(d.getDate())}/${p(d.getMonth()+1)}  ·  ${hora}`;
}
function fmtViagem(h){ if(h==null)return"—"; if(h<1)return Math.round(h*60)+" min"; const m=Math.round((h-Math.floor(h))*60); return Math.floor(h)+"h"+(m?String(m).padStart(2,"0"):""); }

/* Atualiza o KPI do cabeçalho (chamado a cada refresh) */
function renderDespachoKPI(){
  const b=document.getElementById("kDisp");
  let prox=null, proxBase="", conflTot=0;
  for(const base in DESPACHO_BASES){
    const {plan,conflitos}=despachoBase(base);
    conflTot+=conflitos;
    if(plan.length && (prox===null || plan[0].depart<prox.depart)){ prox=plan[0]; proxBase=base; }
  }
  if(prox===null){ b.textContent="ok"; b.style.color="var(--green)"; return; }
  if(conflTot){ b.textContent=conflTot+" conflito"+(conflTot>1?"s":""); b.style.color="var(--red)"; }
  else if(prox.depart<=0.25){ b.textContent="Sair: "+labelDespacho(proxBase,prox.n); b.style.color="var(--orange)"; }
  else { b.textContent=fmtRelogio(prox.depart)+" "+labelDespacho(proxBase,prox.n); b.style.color="var(--cyan)"; }
}

