    "TROPICAL":[-17.799046971057447,-41.786611987253515],"BARRIGÃO":[-20.247201068273977,-42.142691617280825]}}
};
const ROTA_IDX={};
for(const _b in ROTA_BASES){ const _B=ROTA_BASES[_b]; for(const _e in _B.emp){ ROTA_IDX[_e]={base:_b,baseLL:_B.ll,destLL:_B.emp[_e]}; } }

/* Despacho Betim: 3 caminhões e a troca pode ser feita já a partir de 60 Bar. */
/* ---------- Bases de despacho (nº de caminhões e empresas) ---------- */
const TURNO_DIA = [6, 18];   // dia = 06:00–18:00 (fora disso = noite)
const DESPACHO_BASES = {
  "Betim":           {caminhoes:{dia:3, noite:2}, empresas:REGISTRO["BETIM"]},
  "Poços de Caldas": {caminhoes:2, empresas:["ACQUION","BAIA 1"]},
