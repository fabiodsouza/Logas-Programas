/* ---------- Montagem da grade ---------- */
function buildGrid(){
  const grid=document.getElementById("grid");grid.innerHTML="";
  // Arranjo igual ao sistema: 3 colunas; cada coluna tem linhas; cada linha tem 1+ regiões lado a lado.
  // BETIM dividido em faixas de 4 para alinhar com as faixas das outras colunas
  const B=REGISTRO["BETIM"];
  const LAYOUT=[
    [ {betim:B.slice(0,4),header:true}, {betim:B.slice(4,8),header:false}, {betim:B.slice(8),header:false} ],
    [ ["POÇOS DE CALDAS"], ["POUSO ALEGRE"], ["EXTREMA-MG"] ],
    [ ["IPATINGA"], ["ESPÍRITO SANTO","BARBACENA"], ["LAGARTO-SE","ORLÂNDIA"] ]
  ];
  const makeCell=(reg,n)=>{
    const el=document.createElement("div");
    el.className="cell";el.dataset.n=n;el.dataset.reg=reg;
    el.onclick=()=>openDetail(reg,n);
    return el;
  };
  // Cria uma caixa de região. names = empresas; header: mostra título (senão reserva o espaço);
  // cols = nº de colunas iguais da grade (4 em região cheia, 2 em região pareada de meia coluna).
  const addBox=(rowEl,reg,names,header,cols)=>{
    const qt=REGISTRO[reg].length;
    const r=document.createElement("div");r.className="region";
    r.innerHTML = header
      ? `<h2>${reg}<span class="cnt">${qt}</span></h2><div class="cells"></div>`
      : `<h2 class="hidden">${reg}</h2><div class="cells"></div>`;
    const cells=r.querySelector(".cells");
    cells.style.gridTemplateColumns="repeat("+cols+",minmax(0,1fr))";
    names.forEach(n=>cells.appendChild(makeCell(reg,n)));
    rowEl.appendChild(r);
  };
  // Monta cada coluna. Item pode ser: ["REG"] (uma região cheia), ["REG1","REG2"] (pareadas),
  // ou {betim:[empresas], header:bool} (faixa do BETIM, sempre 4 colunas).
  LAYOUT.forEach(colDef=>{
    const col=document.createElement("div");col.className="col";
    colDef.forEach(item=>{
      const row=document.createElement("div");row.className="rrow";
      if(Array.isArray(item)){
        const cols = item.length>=2 ? 2 : 4;   // pareadas (meia coluna) → 2; sozinha (coluna cheia) → 4
        item.forEach(reg=>addBox(row,reg,REGISTRO[reg],true,cols));
      } else if(item.betim){
        addBox(row,"BETIM",item.betim,item.header,4);
      }
      col.appendChild(row);
    });
    grid.appendChild(col);
  });
}

function refresh(){
  let crit=0,urg=0,soon=null,soonName="",semSinal=0;
  const grpDone=new Set();
  const evCrit=[],evUrg=[],evSs=[];
  document.querySelectorAll(".cell").forEach(el=>{
    const n=el.dataset.n,e=estado(n);
    const regN=REGIAO_DE[n]||"";
    if(e.semSinal)semSinal++;
    el.className="cell "+(e.off?"off":(e.key==="ok"?"":e.key))+(e.semSinal?" ss":"");
    const ssDot=e.semSinal?`<span class="ssdot" title="Fora do ar">○</span>`:"";
    const suspDot=e.suspeita?`<span class="ssdot" style="color:var(--yellow)" title="Última leitura ignorada (queda implausível p/ ~${vbar(e.suspeita.lida)} Bar) — confira e corrija no detalhe">⚠</span>`:"";
    if(e.off){
      el.innerHTML=`${ssDot}<div class="nm" title="${nomeExib(n)}">${nomeExib(n)}</div><div class="pr">${e.obs||"sem leitura"}</div>`;
      evSs.push({reg:regN,n,clickN:n,p:null,obs:e.obs||"sem leitura",foraH:e.foraHoras,key:null});
      return;
    }
    if(e.grupo){
      if(!grpDone.has(e.grupo)){
        grpDone.add(e.grupo);
        if(e.key==="crit")crit++; else if(e.key==="urg")urg++;
        if(soon===null||e.h<soon){soon=e.h;soonName=e.grupo;}
      }
      if(e.suprindo){
        if(e.key==="crit")evCrit.push({reg:e.grupo,n:e.grupo,clickN:n,p:e.p,col:e.col,tag:e.tag,h:e.h,medido:e.medido,rate:e.rate});
        else if(e.key==="urg")evUrg.push({reg:e.grupo,n:e.grupo,clickN:n,p:e.p,col:e.col,tag:e.tag,h:e.h,medido:e.medido,rate:e.rate});
      }
    } else {
      if(e.key==="crit")crit++;if(e.key==="urg")urg++;
      if(soon===null||e.h<soon){soon=e.h;soonName=n;}
      if(e.semSinal){
        evSs.push({reg:regN,n,clickN:n,p:e.p,obs:e.obs||"Sem Sinal",foraH:e.foraHoras,key:e.key,col:e.col,tag:e.tag,medido:e.medido,rate:e.rate,projetado:e.projetado,pConhecido:e.pConhecido});
      } else if(e.key==="crit"){
        evCrit.push({reg:regN,n,clickN:n,p:e.p,col:e.col,tag:e.tag,h:e.h,medido:e.medido,rate:e.rate});
      } else if(e.key==="urg"){
        evUrg.push({reg:regN,n,clickN:n,p:e.p,col:e.col,tag:e.tag,h:e.h,medido:e.medido,rate:e.rate});
      }
    }
    const pill=(e.key==="crit"||e.key==="urg")
      ?`<span class="pill" style="background:${e.col};color:#0a0f18">${e.tag}</span>`:"";
    const hr=(e.key==="crit"||e.key==="urg")?"":`<span class="hr" style="color:${e.col}">${e.tag}</span>`;
    const rateTxt=e.medido!=null?`${round(e.medido)} Bar/h`:`~${round(e.rate)} Bar/h`;
    const rateTitle=e.projetado
      ? `previsto a partir de ${vbar(e.pConhecido)} Bar · ${fmtH(e.h)} até o limite`
      : (e.temDespacho?`${e.base} · ${fmtH(e.h)} até o limite`:`base a definir · ${fmtH(e.h)} até o limite`);
    const prPrefix=e.projetado?'<span title="Pressão prevista (sem sinal)" style="color:var(--muted)">≈</span>':'';
    el.innerHTML=`<span class="arrow">⤢</span>${ssDot}${suspDot}
      <div class="nm" title="${nomeExib(n)}">${nomeExib(n)}</div>
      <div class="pr">${prPrefix}${vbar(e.p)}<small>Bar</small></div>
      <div class="rate" title="${rateTitle}">${e.projetado?"prev. ":""}${rateTxt} · ${fmtH(e.h)} limite</div>
      <div class="foot">${hr}${pill}</div>`;
  });
  document.getElementById("kCrit").textContent=crit;
  document.getElementById("kUrg").textContent=urg;
  const ssEl=document.getElementById("kSemSinal");
  ssEl.textContent=semSinal;
  ssEl.style.color=semSinal>0?"var(--red)":"var(--muted)";
  const d=window.LOGAS_DADOS;
  const qt=d&&d.atualizado?new Date(d.atualizado).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"—";
  document.getElementById("sub").textContent=
    `Última foto lida: ${qt} · próxima a esvaziar: ${soonName||"–"} · ${semSinal} sem sinal · clique numa empresa para o histórico`;
  evCrit.sort((a,b)=>a.h-b.h);
  evUrg.sort((a,b)=>a.h-b.h);
  evSs.sort((a,b)=>(b.foraH||0)-(a.foraH||0));
  renderAlertPanel(evCrit,evUrg,evSs);
  renderDespachoKPI();
  if(document.getElementById("dispOverlay").classList.contains("open") && !(document.activeElement&&document.activeElement.closest&&document.activeElement.closest("#dispTable"))) renderDespacho();
}

/* ---------- Painel lateral de alertas ---------- */
function alertRow(ev,type){
  const reg=ev.reg||"";
  const prPrefix = ev.projetado ? '<span style="color:var(--muted)" title="Pressão prevista (sem sinal)">≈</span>' : '';
  const prTxt = ev.p!=null ? `${prPrefix}${vbar(ev.p)}<small style="color:var(--muted)"> Bar</small>` : '<span style="color:var(--muted)">— Bar</span>';
  // Consumo por hora segundo a última leitura (medido entre fotos; ~ = estimado provisório)
  const rateTxt = ev.medido!=null ? `${round(ev.medido)} Bar/h`
                : (ev.rate!=null ? `~${round(ev.rate)} Bar/h` : "");
  let tag="";
  if(type==="ss"){
    if(ev.key==="crit"||ev.key==="urg"){
      const c=ev.key==="crit"?"var(--red)":"var(--orange)";
      tag=`<span class="pill" style="background:${c};color:#0a0f18">${ev.key==="crit"?"CRÍTICO":"URGENTE"}</span>`;
    } else {
      tag=`<span class="pill" style="background:var(--muted);color:#0a0f18">${ev.obs||"Sem Sinal"}</span>`;
    }
  } else {
    tag=`<span class="pill" style="background:${ev.col};color:#0a0f18">${ev.tag}</span>`;
  }
  const subParts=[];
  if(ev.projetado && ev.pConhecido!=null) subParts.push(`prev. (últ. ${vbar(ev.pConhecido)})`);
  if(rateTxt) subParts.push(`consumo ${rateTxt}`);
  if(type==="ss" && ev.foraH!=null && isFinite(ev.foraH)) subParts.push(`fora do ar há ${fmtH(ev.foraH)}`);
  const sub = subParts.length ? `<div class="ai-sub">${subParts.join(" · ")}</div>` : "";
  return `<div class="alert-item ${type}" data-n="${ev.clickN}" data-reg="${reg}">
    <div class="ai-top"><span class="ai-nm" title="${ev.n}">${ev.n}</span><span class="ai-reg">${reg}</span></div>
    <div class="ai-bot"><span class="ai-pr">${prTxt}</span>${tag}</div>${sub}</div>`;
}
function renderAlertPanel(c,u,s){
  const fill=(id,arr,type,emptyMsg)=>{
    document.getElementById(id).innerHTML = arr.length
      ? arr.map(ev=>alertRow(ev,type)).join("")
      : `<div class="ai-empty">${emptyMsg}</div>`;
  };
  fill("apCrit",c,"crit","Nenhum evento crítico");
  fill("apUrg",u,"urg","Nenhum evento urgente");
  fill("apSs",s,"ss","Tudo com sinal");
  document.getElementById("apCritN").textContent=c.length;
  document.getElementById("apUrgN").textContent=u.length;
  document.getElementById("apSsN").textContent=s.length;
  document.querySelectorAll("#alertPanel .alert-item").forEach(it=>{
    it.onclick=()=>openDetail(it.dataset.reg,it.dataset.n);
  });
}

/* ---------- Exportação de relatórios (CSV / Excel) ----------
   Gera DOIS arquivos pensados para alimentar dashboards depois:
   1) logas-leituras-...csv  → dados brutos (1 linha por leitura) com flags e consumo já calculados;
   2) logas-resumo-...csv    → 1 linha por empresa com os indicadores agregados + linha de totais.
   Formato: separador ";" e vírgula decimal (abre direto no Excel pt-BR), com BOM UTF-8. */
function csvNum(x){ if(x==null||x==="")return ""; return (Math.round(x*100)/100).toString().replace(".",","); }
function baixarCSV(nome,linhas){
  const csv="﻿"+linhas.join("\r\n");
  const blob=new Blob([csv],{type:"text/csv;charset=utf-8;"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob); a.download=nome; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),3000);
}
function dentroPeriodo(t,dDe,dAte){ const x=new Date(t); return (!dDe||x>=dDe)&&(!dAte||x<=dAte); }
function leiturasPeriodo(n,dDe,dAte){ return leituras(n).filter(r=>dentroPeriodo(r.t,dDe,dAte)); }

/* ---------- Planilha pivô (Excel .xlsx, gerada no navegador) ----------
   Mesmo formato da planilha do operador: 1 linha por horário, 1 coluna por empresa,
   célula = pressão lida (já com correções e leituras manuais aplicadas). Sem cores. */
function fmtDataPivo(ts){
  const d=new Date(ts), p=x=>String(x).padStart(2,"0");
  return `${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}`;
}
function dadosPivo(dDe,dAte){
  const empresas=[]; for(const reg in REGISTRO) REGISTRO[reg].forEach(n=>empresas.push(n));
  const mapas={}, tset=new Set();
  empresas.forEach(n=>{ const m={};
    leituras(n).forEach(r=>{ if(!dentroPeriodo(r.t,dDe,dAte))return; m[r.t]=r; tset.add(r.t); });
    mapas[n]=m;
  });
  const tss=[...tset].sort((a,b)=>new Date(a)-new Date(b));
  return {empresas,mapas,tss};
}
function cabPivo(n){ return grupoDe(n) ? nomeExib(n)+" ("+REGIAO_DE[n]+")" : nomeExib(n); }
function exportarPivoXLSX(dDe,dAte){
  const {empresas,mapas,tss}=dadosPivo(dDe,dAte);
  // cabeçalho: Data, e por empresa [bar, #] (igual às abas de mês do modelo)
  const header=["Data"]; empresas.forEach(n=>{ header.push(cabPivo(n)); header.push("#"); });
  const aoa=[header];
  tss.forEach(ts=>{
    const row=[fmtDataPivo(ts)];
    empresas.forEach(n=>{ const r=mapas[n][ts]; row.push(r&&r.p!=null?r.p:null); row.push(null); });
    aoa.push(row);
  });
  const ws=XLSX.utils.aoa_to_sheet(aoa);
  // consumo (#) = bar(hora anterior) − bar(hora atual). Grava a fórmula VIVA + o valor
  // calculado (o SheetJS só escreve a célula de fórmula se ela tiver um valor em cache).
  // Só preenche quando há leitura nas duas horas, para não gerar número errado nas lacunas.
  const nrows=tss.length;
  empresas.forEach((n,j)=>{
    const barCol=1+2*j, hashCol=2+2*j, L=XLSX.utils.encode_col(barCol);
    for(let i=1;i<nrows;i++){
      const prevR=mapas[n][tss[i-1]], curR=mapas[n][tss[i]];
      if(!(prevR&&prevR.p!=null&&curR&&curR.p!=null)) continue;
      const exRow=i+2, addr=XLSX.utils.encode_cell({r:i+1,c:hashCol});
      ws[addr]={t:"n",f:`${L}${exRow-1}-${L}${exRow}`,v:Math.round((prevR.p-curR.p)*100)/100};
    }
  });
  const cols=[{wch:17}]; empresas.forEach(()=>{cols.push({wch:11},{wch:7});});
  ws["!cols"]=cols;
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,"Pivo");
  XLSX.writeFile(wb,"logas-pivo-"+new Date().toISOString().slice(0,10)+".xlsx");
}
function statsEmpresa(n,dDe,dAte){
  const ls=leiturasPeriodo(n,dDe,dAte);       // sorted, inclui nulos, dentro do período
  const num=ls.filter(r=>r.p!=null&&r.p!==undefined);
  const taxas=[]; let refills=0, refillsAlta=0;
  for(let i=1;i<num.length;i++){
    const dh=(new Date(num[i].t)-new Date(num[i-1].t))/3600000;
    if(dh<=0) continue;
    const diff=num[i].p-num[i-1].p;
    if(diff<0) taxas.push((-diff)/dh);                         // queda = consumo
    else if(diff>=TROCA_MIN_BAR && num[i].p>=TROCA_NOVA){ refills++; if(num[i-1].p>ADIANTAR_BAR) refillsAlta++; } // troca de carreta (sobe p/ ≥160)
  }
  const consumoMedio = taxas.length? taxas.reduce((a,b)=>a+b,0)/taxas.length : null;
  const consumoPico  = taxas.length? Math.max(...taxas) : null;
  let semSinalH=0, quedas=0, inRun=false;
  for(let i=0;i<ls.length;i++){
    if(ls[i].p==null){
      if(!inRun){ quedas++; inRun=true; }
      const fim=(i+1<ls.length)? new Date(ls[i+1].t) : new Date();
      semSinalH += (fim-new Date(ls[i].t))/3600000;
    } else inRun=false;
  }
  const ultima=num.length?num[num.length-1]:null;
  const menor=num.length?Math.min(...num.map(r=>r.p)):null;
  return {n, reg:REGIAO_DE[n]||"", nLeituras:num.length,
          ultimaP:ultima?ultima.p:null, ultimaT:ultima?ultima.t:null,
          menorP:menor, consumoMedio, consumoPico, refills, refillsAlta, semSinalH, quedas};
}
/* Abre o diálogo de exportação, pré-preenchendo o período com o intervalo disponível nos dados. */
function abrirExport(){
  let min=null,max=null;
  for(const reg in REGISTRO) REGISTRO[reg].forEach(n=>leituras(n).forEach(r=>{
    const x=new Date(r.t); if(!min||x<min)min=x; if(!max||x>max)max=x;
  }));
  const iso=d=>d?d.toISOString().slice(0,10):"";
  document.getElementById("expDe").value=iso(min);
  document.getElementById("expAte").value=iso(max);
  document.getElementById("exportOverlay").classList.add("open");
}
function exportarRelatorio(){
 try{
  const sep=";";
  let gerados=0;
  const de=document.getElementById("expDe").value, ate=document.getElementById("expAte").value;
  const dDe = de? new Date(de+"T00:00:00") : null;
  const dAte = ate? new Date(ate+"T23:59:59") : null;
  const ind={}; document.querySelectorAll("#expIndic input[data-ind]").forEach(c=>ind[c.dataset.ind]=c.checked);
  const wResumo=document.getElementById("expResumo").checked, wBrutos=document.getElementById("expBrutos").checked;
  const wPivo=document.getElementById("expPivo").checked;
  if(!wResumo&&!wBrutos&&!wPivo){ document.getElementById("expMsg").textContent="Marque pelo menos um arquivo."; return; }
  const empresas=[]; for(const reg in REGISTRO) REGISTRO[reg].forEach(n=>empresas.push(n));
  const dataStr=new Date().toISOString().slice(0,10);
  const d=window.LOGAS_DADOS;
  const periodoTxt = (de||ate)? `periodo: ${de||"inicio"} a ${ate||"fim"}` : "periodo: todo o historico";
  const meta=`Relatorio Logas`+sep+`gerado em ${new Date().toLocaleString("pt-BR")}`+sep+periodoTxt;

  // 2) RESUMO por empresa (colunas conforme indicadores escolhidos)
  if(wResumo){
    const cols=[{h:"Empresa",v:s=>s.n},{h:"Regiao",v:s=>s.reg}];
    if(ind.leituras) cols.push({h:"Leituras",v:s=>s.nLeituras,tot:"n"});
    if(ind.ultima){ cols.push({h:"UltimaPressaoBar",v:s=>csvNum(s.ultimaP)},
                              {h:"UltimaLeitura",v:s=>s.ultimaT?new Date(s.ultimaT).toLocaleString("pt-BR"):""},
                              {h:"MenorPressaoBar",v:s=>csvNum(s.menorP)}); }
    if(ind.consumo){ cols.push({h:"ConsumoMedioBarH",v:s=>csvNum(s.consumoMedio)},
                               {h:"PicoConsumoBarH",v:s=>csvNum(s.consumoPico)}); }
    if(ind.abast) cols.push({h:"Abastecimentos",v:s=>s.refills,tot:"sum",k:"refills"});
    if(ind.abastAlta) cols.push({h:"AbastecimentosPressaoAlta",v:s=>s.refillsAlta,tot:"sum",k:"refillsAlta"});
    if(ind.semsinal){ cols.push({h:"TempoSemSinalH",v:s=>csvNum(s.semSinalH),tot:"sumh",k:"semSinalH"},
                                {h:"QuedasDeSinal",v:s=>s.quedas,tot:"sum",k:"quedas"}); }
    const linhasR=[meta,"",cols.map(c=>c.h).join(sep)];
    const tot={refills:0,refillsAlta:0,semSinalH:0,quedas:0};
    empresas.forEach(n=>{ const s=statsEmpresa(n,dDe,dAte);
      tot.refills+=s.refills;tot.refillsAlta+=s.refillsAlta;tot.semSinalH+=s.semSinalH;tot.quedas+=s.quedas;
      linhasR.push(cols.map(c=>c.v(s)).join(sep)); });
    linhasR.push(cols.map((c,i)=>{ if(i===0)return"TOTAIS"; if(c.tot==="sum")return tot[c.k];
      if(c.tot==="sumh")return csvNum(tot[c.k]); return ""; }).join(sep));
    baixarCSV("logas-resumo-"+dataStr+".csv",linhasR); gerados++;
  }

  // 1) DADOS BRUTOS (tidy) — base para dashboards
  if(wBrutos){
    const headL=["Empresa","Regiao","DataHora","Data","Hora","PressaoBar","Status","SemSinal",
                 "HorasDesdeAnterior","VariacaoBar","ConsumoBarH","Evento","Abastecimento","AbastecimentoPressaoAlta"];
    const linhasL=[meta,"",headL.join(sep)];
    empresas.forEach(n=>{
      const ls=leiturasPeriodo(n,dDe,dAte); let prevNum=null, prevT=null;
      for(let i=0;i<ls.length;i++){
        const r=ls[i], dObj=new Date(r.t);
        let horasAnt="", varBar="", consumo="", evento, abast=0, abastAlta=0;
        if(i>0) horasAnt=(dObj-new Date(ls[i-1].t))/3600000;
        if(r.p==null){ evento=r.obs||"Sem Sinal"; }
        else{
          if(prevNum!=null){
            const dh=(dObj-new Date(prevT))/3600000, diff=r.p-prevNum; varBar=diff;
            if(diff<0&&dh>0){ consumo=(-diff)/dh; evento="Queda"; }
            else if(diff>=TROCA_MIN_BAR && r.p>=TROCA_NOVA){ evento="Abastecimento"; abast=1; if(prevNum>ADIANTAR_BAR) abastAlta=1; }
            else evento="Leitura";
          } else evento="Leitura";
          prevNum=r.p; prevT=r.t;
        }
        linhasL.push([n,REGIAO_DE[n]||"",r.t,dObj.toLocaleDateString("pt-BR"),dObj.toLocaleTimeString("pt-BR"),
          csvNum(r.p),(r.p==null?(r.obs||"Sem Sinal"):"OK"),(r.p==null?1:0),
          csvNum(horasAnt),csvNum(varBar),csvNum(consumo),evento,abast,abastAlta].join(sep));
      }
    });
    baixarCSV("logas-leituras-"+dataStr+".csv",linhasL); gerados++;
  }
  if(wPivo){
    if(typeof XLSX==="undefined"){
      document.getElementById("expMsg").textContent="CSV gerado. A planilha Excel não carregou (precisa de internet para a biblioteca).";
      return;
    }
    exportarPivoXLSX(dDe,dAte); gerados++;
  }
  document.getElementById("expMsg").textContent="✓ "+gerados+" arquivo(s) gerado(s). Veja em Downloads.";
 }catch(err){
  document.getElementById("expMsg").textContent="Erro ao exportar: "+(err&&err.message?err.message:err);
 }
}

/* ---------- Detalhe + gráfico (histórico REAL das fotos) ---------- */
let chart=null,current=null;
function openDetail(reg,n){
  current={reg,n};
  const e=estado(n);
  document.getElementById("dName").textContent=nomeExib(n);
  document.getElementById("dReg").textContent=reg;

  const hhmm=t=>new Date(t).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"});
  const num=leituras(n).filter(r=>r.p!==null&&r.p!==undefined);
  const cur=num[num.length-1], prev=num[num.length-2];

  // Banner de fora do ar
  const off=document.getElementById("dOffline");
  if(e.semSinal){
    off.style.display="block";
    const desdeTxt=e.desde?new Date(e.desde).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"—";
    const motivo = e.projetado ? "Sem Sinal" : (e.obs||"Sem Sinal");
    let html=`<div style="font-weight:700">⚠ Fora do ar desde ${desdeTxt} · há ${fmtH(e.foraHoras)} <span style="font-weight:400;opacity:.85">(${motivo})</span></div>`;
    if(e.projetado){
      html+=`<div style="margin-top:6px;font-weight:400;opacity:.95">`
        +`Última leitura real: <b>${vbar(e.pConhecido)} Bar</b> às ${hhmm(e.tLeitura)} · consumo antes de ficar Sem Sinal: <b>${round(e.rate)} Bar/h</b><br>`
        +`Pressão estimada agora, se continuar gastando no mesmo ritmo das últimas horas: <b>≈${vbar(e.p)} Bar</b>.`
        +`</div>`;
    } else if(num.length){
      html+=`<div style="margin-top:6px;font-weight:400;opacity:.95">Mostrando o último valor conhecido e o consumo medido antes de cair.</div>`;
    } else {
      html+=`<div style="margin-top:6px;font-weight:400;opacity:.95">Sem leituras numéricas registradas.</div>`;
    }
    off.innerHTML=html;
  } else off.style.display="none";

  // Pressão atual e leitura anterior (com horário). Fora do ar → previsão + última leitura real.
  const prevEl=document.getElementById("sPrev"), prevL=document.getElementById("sPrevL");
  if(e.projetado){
    document.getElementById("sP").textContent="≈"+vbar(e.p);
    document.getElementById("sPL").textContent="Pressão prevista agora (s/ sinal)";
    if(cur){ prevEl.textContent=vbar(cur.p); prevL.textContent="Última leitura real · "+hhmm(cur.t); }
    else { prevEl.textContent="—"; prevL.textContent="Última leitura real"; }
  } else {
    document.getElementById("sP").textContent=e.p!=null?vbar(e.p):"—";
    document.getElementById("sPL").textContent= cur?("Pressão atual · "+hhmm(cur.t)):"Pressão atual (Bar)";
    if(prev){ prevEl.textContent=vbar(prev.p); prevL.textContent="Leitura anterior · "+hhmm(prev.t); }
    else { prevEl.textContent="—"; prevL.textContent="Leitura anterior"; }
    if(cur&&cur.corrigido) document.getElementById("sPL").textContent+=" · ✎ corrigido";
  }

  // Consumo na última hora (entre as duas últimas leituras)
  const lastEl=document.getElementById("sLast");
  if(prev&&cur){
    const dh=(new Date(cur.t)-new Date(prev.t))/3600000;
    const queda=prev.p-cur.p;
    const aumento=-queda;
    if(dh<=0){ lastEl.textContent="—"; lastEl.style.color=""; }
    else if(aumento>=TROCA_MIN_BAR && cur.p>=TROCA_NOVA){
      lastEl.textContent="troca de carreta · nova: "+vbar(cur.p)+" Bar";
      lastEl.style.color="var(--green)";
    } else if(queda>=0){
      lastEl.textContent=round(queda)+" Bar ("+round(queda/dh)+"/h)";
      lastEl.style.color="var(--cyan)";
    } else {
      lastEl.textContent="variação +"+round(aumento)+" Bar";
      lastEl.style.color="var(--muted)";
    }
  } else { lastEl.textContent="—"; lastEl.style.color=""; }

  document.getElementById("sRate").textContent=e.medido!=null?round(e.medido):"—";
  document.getElementById("sMin").textContent=e.min!=null?e.min:getMin(n);
  const hEl=document.getElementById("sH");hEl.textContent=fmtH(e.h);hEl.style.color=e.col||"var(--muted)";

  // Base, viagem e horário-limite de saída
  document.getElementById("sBase").textContent=e.base||"a definir";
  {
    const sv=document.getElementById("sViagem");
    const usaLive = !(cfg.viagem&&cfg.viagem[n]!=null&&cfg.viagem[n]!=="") && viagemLive(n)!=null;
    sv.textContent=(e.viagem!=null?e.viagem:"—")+(usaLive?" ⟲":"");
    sv.title=usaLive?("tempo real (TomTom)"+(window.LOGAS_VIAGEM&&window.LOGAS_VIAGEM.atualizado?" · "+new Date(window.LOGAS_VIAGEM.atualizado).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"")):"";
  }
  const saidaEl=document.getElementById("sSaida");
  if(e.temDespacho){
    if(e.despacho<=0){ saidaEl.textContent="DESPACHAR JÁ"; saidaEl.style.color="var(--red)"; }
    else {
      const dl=new Date(Date.now()+e.despacho*3600*1000);
      const hoje=new Date().toDateString()===dl.toDateString();
      saidaEl.textContent=dl.toLocaleString("pt-BR",hoje?{hour:"2-digit",minute:"2-digit"}:{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"});
      saidaEl.style.color=e.col;
    }
  } else { saidaEl.textContent="—"; saidaEl.style.color=""; }

  const ls=leituras(n);
  const labels=ls.map(r=>new Date(r.t).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}));
  const pts=ls.map(r=>(r.p==null?null:r.p));
  const note=document.getElementById("dNote");
  if(ls.length<2)note.textContent="Apenas 1 leitura registrada até agora. O gráfico e o consumo medido ficam completos a partir da 2ª foto.";
  else note.textContent=`${ls.length} leituras registradas. Consumo medido pela diferença real entre as fotos.`;

  // Projeção no gráfico quando fora do ar: liga a última leitura real ao ponto previsto "agora".
  let projData=null;
  if(e.projetado){
    let lastReal=-1; for(let i=ls.length-1;i>=0;i--){ if(ls[i].p!=null){lastReal=i;break;} }
    labels.push("agora (prev.)");
    pts.push(null);
    projData=labels.map(()=>null);
    if(lastReal>=0) projData[lastReal]=e.pConhecido;
    projData[labels.length-1]=e.p;
    note.textContent+=` Linha tracejada laranja = previsão sem sinal (≈${vbar(e.p)} Bar agora).`;
  }

  const datasets=[
    {label:"Pressão (Bar)",data:pts,borderColor:"#3bc4ec",backgroundColor:"rgba(59,196,236,.15)",
     fill:true,tension:.3,pointRadius:3,borderWidth:2,spanGaps:true},
    {label:"Limite crítico",data:labels.map(()=>getMin(n)),borderColor:"#f1556a",borderDash:[6,5],
     pointRadius:0,borderWidth:1.5,fill:false}
  ];
  if(projData) datasets.push({label:"Previsão (s/ sinal)",data:projData,borderColor:"#f59140",
     borderDash:[4,4],pointRadius:4,pointBackgroundColor:"#f59140",borderWidth:2,fill:false,spanGaps:true});

  const ctx=document.getElementById("chart");
  if(chart)chart.destroy();
  chart=new Chart(ctx,{
    type:"line",
    data:{labels,datasets},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{color:"#cfe0f5"}}},
      scales:{x:{ticks:{color:"#8298b9",maxRotation:0,autoSkip:true},grid:{color:"rgba(255,255,255,.05)"}},
              y:{ticks:{color:"#8298b9"},grid:{color:"rgba(255,255,255,.05)"},title:{display:true,text:"Bar",color:"#8298b9"}}}}
  });
  // Campo de leitura manual
  const hint=document.getElementById("dNowHint");
  hint.textContent="· será registrada às "+new Date().toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"});
  document.getElementById("dNewVal").value="";
  document.getElementById("dAddMsg").textContent="";

  // Campo de correção de leitura
  document.getElementById("dCorrMsg").textContent="";
  popularCorrecao(n);
  document.getElementById("dRota").style.display = (rotaInfo(n)?"inline-block":"none");

  document.getElementById("detailOverlay").classList.add("open");
}
function closeDetail(){document.getElementById("detailOverlay").classList.remove("open");if(chart){chart.destroy();chart=null;}}

/* Registra uma leitura manual (digitada) no histórico da empresa atual */
function registrarLeitura(p,obs){
  if(!current)return;
  const n=current.n, s=manualStore();
  s[n]=s[n]||[];
  const entry={t:nowLocalISO(), p:p};
  if(p===null) entry.obs=obs||"Sem Sinal";
  s[n].push(entry);
  saveManual(s);
  refresh();
  openDetail(current.reg,n);
  document.getElementById("dAddMsg").textContent = p===null ? "Registrado: Sem Sinal." : "Registrado: "+vbar(p)+" Bar.";
}
function desfazerManual(){
  if(!current)return;
  const n=current.n, s=manualStore();
  if(s[n]&&s[n].length){ s[n].pop(); if(!s[n].length)delete s[n]; saveManual(s); refresh(); openDetail(current.reg,n);
    document.getElementById("dAddMsg").textContent="Última leitura manual desfeita."; }
  else document.getElementById("dAddMsg").textContent="Nenhuma leitura manual para desfazer.";
}

/* ---------- Correção de leitura (automática OU manual) ---------- */
let _corrList=[];
function leiturasEditaveis(n){
  const auto=leiturasBase(n).map(r=>({t:r.t,p:r.p,origem:"auto",corrigido:!!r.corrigido}));
  const man=(manualStore()[n]||[]).map((r,i)=>({t:r.t,p:(r.p==null?null:r.p),origem:"manual",idx:i}));
  const all=auto.concat(man);
  all.sort((a,b)=>new Date(a.t)-new Date(b.t));
  return all;
}
function popularCorrecao(n){
  const sel=document.getElementById("dCorrSel");
  _corrList=leiturasEditaveis(n).slice().reverse();
  sel.innerHTML="";
  if(!_corrList.length){
    const o=document.createElement("option"); o.value=""; o.textContent="(sem leitura registrada)";
    sel.appendChild(o);
  } else {
    _corrList.slice(0,40).forEach((r,i)=>{
      const quando=new Date(r.t).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"});
      const val=r.p==null?"sem sinal":vbar(r.p)+" Bar";
      const tipo=r.origem==="manual"?" · manual":(r.corrigido?" · corrigido":"");
      const o=document.createElement("option");
      o.value=String(i); o.textContent=quando+" · "+val+tipo;
      sel.appendChild(o);
    });
  }
  sincronizarValorCorrecao();
}
function sincronizarValorCorrecao(){
  const sel=document.getElementById("dCorrSel");
  const r=_corrList[parseInt(sel.value)];
  document.getElementById("dCorrVal").value=(r&&r.p!=null)?r.p:"";
}
function _reabrirNaLeitura(n,ref){
  refresh(); openDetail(current.reg,n);
  const sel=document.getElementById("dCorrSel");
  const pos=_corrList.findIndex(x=>x.t===ref.t && x.origem===ref.origem);
  if(pos>=0){ sel.value=String(pos); sincronizarValorCorrecao(); }
}
function salvarCorrecao(){
  if(!current)return;
  const n=current.n, msg=document.getElementById("dCorrMsg");
  const r=_corrList[parseInt(document.getElementById("dCorrSel").value)];
  const v=document.getElementById("dCorrVal").value;
  if(!r){ msg.textContent="Sem leitura para corrigir."; return; }
  if(v===""){ msg.textContent="Digite o valor correto."; return; }
  const novo=parseFloat(v);
  if(isNaN(novo)){ msg.textContent="Valor inválido."; return; }
  if(r.origem==="manual"){
    const st=manualStore();
    if(st[n]&&st[n][r.idx]){ st[n][r.idx].p=novo; delete st[n][r.idx].obs; saveManual(st); }
  } else {
    const ss=correcoesStore(); ss[n]=ss[n]||{}; ss[n][r.t]=novo; saveCorrecoes(ss);
  }
  _reabrirNaLeitura(n,r);
  document.getElementById("dCorrMsg").textContent="Valor salvo: "+vbar(novo)+" Bar.";
}
function removerCorrecao(){
  if(!current)return;
  const n=current.n, msg=document.getElementById("dCorrMsg");
  const r=_corrList[parseInt(document.getElementById("dCorrSel").value)];
  if(!r){ msg.textContent="Sem leitura selecionada."; return; }
  if(r.origem==="manual"){ msg.textContent="Leitura manual: use \"Desfazer manual\" para removê-la."; return; }
  const ss=correcoesStore();
  if(ss[n]&&ss[n][r.t]!=null){
    delete ss[n][r.t]; if(!Object.keys(ss[n]).length)delete ss[n]; saveCorrecoes(ss);
    _reabrirNaLeitura(n,r);
    document.getElementById("dCorrMsg").textContent="Correção removida — valor original restaurado.";
  } else msg.textContent="Esta leitura não tem correção.";
}

/* ---------- Config ---------- */
function buildCfg(){
  if(cfg.buffer!=null)document.getElementById("buffer").value=cfg.buffer;
  if(cfg.fallback!=null)document.getElementById("fallback").value=cfg.fallback;
  const tb=document.querySelector("#cfgTable tbody");
  tb.innerHTML=`<tr><th>Empresa</th><th>Limite (Bar)</th><th>Base</th><th>Viagem (h)</th><th>Consumo medido</th></tr>`;
  for(const reg in REGISTRO){
    tb.insertAdjacentHTML("beforeend",`<tr><td colspan="5" style="color:var(--cyan);font-weight:700">${reg}</td></tr>`);
    REGISTRO[reg].forEach(n=>{
      const m=consumoMedido(n);
      tb.insertAdjacentHTML("beforeend",`<tr>
        <td>${nomeExib(n)}</td>
        <td><input type="number" step="1" value="${getMin(n)}" data-k="min" data-n="${n}"></td>
        <td><input type="text" value="${getBase(n)}" data-k="base" data-n="${n}" style="width:96px;text-align:left"></td>
        <td><input type="number" step="0.5" min="0" value="${getViagem(n)!=null?getViagem(n):''}" data-k="viagem" data-n="${n}" placeholder="—"></td>
        <td style="color:var(--muted)">${m!=null?round(m)+" Bar/h":"aguardando 2ª foto"}</td>
      </tr>`);
    });
  }
  tb.querySelectorAll("input").forEach(inp=>inp.addEventListener("input",e=>{
    const k=e.target.dataset.k, n=e.target.dataset.n, v=e.target.value;
    if(k==="min"){ cfg.min=cfg.min||{}; cfg.min[n]=parseFloat(v)||0; }
    else if(k==="base"){ cfg.base=cfg.base||{}; cfg.base[n]=v; }
    else if(k==="viagem"){ cfg.viagem=cfg.viagem||{}; cfg.viagem[n]=(v===""?"":parseFloat(v)); }
    saveCfg();refresh();
  }));
}

/* ---------- Recarrega dados.js sem recarregar a página ---------- */
let _ultimoAtualizado=(window.LOGAS_DADOS&&window.LOGAS_DADOS.atualizado)||null;
function recarregarDados(){
  const s=document.createElement("script");
  // No file:// a query string vira parte do nome do arquivo e o load falha — só usa cache-buster em http(s).
  s.src = (location.protocol==="file:") ? "dados.js" : "dados.js?t="+Date.now();
  s.onload=()=>{
    refresh();
    // Se uma foto nova entrou, atualiza o gráfico aberto e dá um aviso discreto.
    const novo=window.LOGAS_DADOS&&window.LOGAS_DADOS.atualizado;
    if(novo&&novo!==_ultimoAtualizado){
      _ultimoAtualizado=novo;
      if(current&&document.getElementById("detailOverlay").classList.contains("open"))
        openDetail(current.reg,current.n);
    }
    s.remove();
  };
  s.onerror=()=>{ s.remove(); };
  document.body.appendChild(s);
}

