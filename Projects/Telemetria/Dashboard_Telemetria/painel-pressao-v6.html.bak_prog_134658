setInterval(tick,1000);
setInterval(recarregarDados,60*1000);    // busca novas leituras a cada 60 s
/* Recarrega viagem.js (tempos reais TomTom) sem recarregar a pagina. */
function recarregarViagem(){
  const s=document.createElement("script");
  s.src=(location.protocol==="file:")?"viagem.js":"viagem.js?t="+Date.now();
  s.onload=()=>{ refresh(); s.remove(); };
  s.onerror=()=>{ s.remove(); };           // viagem.js ainda nao existe -> usa tempos fixos
  document.body.appendChild(s);
}
setInterval(recarregarViagem,5*60*1000);   // atualiza tempos de viagem a cada 5 min
