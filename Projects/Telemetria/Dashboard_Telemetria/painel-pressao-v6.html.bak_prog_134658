};

/* Conjuntos de baias de um mesmo cliente: a baia de maior pressão é a que está
   suprindo e o alerta só dispara quando TODAS estão baixas (igual Extrema-MG). */
const GRUPOS = {
  "EXTREMA-MG":["BAIA 1","BAIA 2","BAIA 3"],
